<% content_for :title, "Users" %>

<div style="margin-bottom:22px;">
  <span class="eyebrow">Team</span>
  <h1 class="page-title" style="margin-top:6px;">Users</h1>
  <p class="muted" style="margin-top:6px; font-size:14px;">Invite teammates and manage their access. Invited users get an email to set their password.</p>
</div>

<% if alert = flash[:alert] %>
  <div class="flash flash--alert" id="alert" style="margin-bottom:16px;"><span><%= alert %></span></div>
<% end %>
<% if notice = flash[:notice] %>
  <div class="flash flash--notice" id="notice" style="margin-bottom:16px;"><span><%= notice %></span></div>
<% end %>

<div class="panel card-pad" style="margin-bottom:22px;">
  <span class="eyebrow">Invite a user</span>
  <%= form_with url: users_path, method: :post, style: "display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap; margin-top:12px;" do |f| %>
    <div class="field" style="flex:1 1 260px; margin:0;">
      <%= f.label "user[email_address]", "Email", class: "label" %>
      <%= f.email_field "user[email_address]", required: true, placeholder: "teammate@example.com",
            value: @user&.email_address, class: "input" %>
    </div>
    <div class="field" style="margin:0;">
      <span class="label">Role</span>
      <div style="display:flex; gap:14px; align-items:center; height:40px;">
        <label class="text-mono-sm" style="display:flex; gap:6px; align-items:center; cursor:pointer;">
          <%= radio_button_tag "user[role]", "employee", true %> Employee
        </label>
        <label class="text-mono-sm" style="display:flex; gap:6px; align-items:center; cursor:pointer;">
          <%= radio_button_tag "user[role]", "admin", false %> Admin
        </label>
      </div>
    </div>
    <%= f.submit "Send invite", class: "btn btn--primary" %>
  <% end %>
</div>

<div class="card card-pad">
  <div style="overflow-x:auto;">
    <table class="data-table">
      <thead>
        <tr><th>Email</th><th>Role</th><th>Status</th><th></th></tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td>
              <%= user.email_address %>
              <% if user == Current.user %><span class="text-mono-sm" style="color:var(--muted-2);">(you)</span><% end %>
            </td>
            <td>
              <%= form_with url: user_path(user), method: :patch, style: "display:flex; gap:8px; align-items:center;" do %>
                <%= select_tag "user[role]", options_for_select(User.roles.keys.map { |r| [r.titleize, r] }, user.role),
                      class: "select", style: "width:auto; padding:6px 10px;",
                      onchange: "this.form.requestSubmit()" %>
                <noscript><button class="btn btn--ghost btn--sm">Save</button></noscript>
              <% end %>
            </td>
            <td>
              <% if user.pending_invite? %>
                <span class="badge badge--neutral"><span class="badge__dot"></span>Pending invite</span>
              <% else %>
                <span class="badge badge--done"><span class="badge__dot"></span>Active</span>
              <% end %>
            </td>
            <td style="text-align:right; white-space:nowrap;">
              <% if user.pending_invite? %>
                <%= button_to "Resend invite", resend_invite_user_path(user), method: :post, class: "btn btn--ghost btn--sm" %>
              <% end %>
              <% unless user == Current.user %>
                <%= button_to "Remove", user_path(user), method: :delete, class: "btn btn--ghost btn--sm",
                      form: { style: "display:inline;", data: { turbo_confirm: "Remove #{user.email_address}?" } } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
