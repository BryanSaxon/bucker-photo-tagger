<% content_for :title, "Upload photos" %>

<div style="margin-bottom:22px;">
  <%= link_to "← Back to photos", photos_path, class: "text-mono-sm", style: "text-decoration:none;" %>
  <h1 class="page-title" style="margin-top:10px;">Upload photos</h1>
  <p class="muted" style="margin-top:6px; font-size:14px;">Add example photos in a batch — pick many files or drop a .zip. Each image lands in the queue as “needs processing.” Optionally tag them with a location to speed up processing.</p>
</div>

<%
  plans_json = @floorplans.map { |id, name, elev, cid| { i: id, l: [ name, elev ].compact_blank.join(" "), c: cid } }
  rooms_json = @rooms.map { |id, desc, code, cid| { i: id, l: (desc.presence || code), c: cid } }
%>

<div class="panel card-pad">
  <%= form_with model: @photo, url: photos_path, method: :post, html: {
        multipart: true, data: { controller: "upload catalog-select",
          action: "submit->upload#submit",
          upload_direct_upload_url_value: rails_direct_uploads_url,
          catalog_select_plans_value: plans_json.to_json,
          catalog_select_rooms_value: rooms_json.to_json } } do |f| %>

    <div class="field">
      <label class="label" for="photo_images">Photo files</label>
      <label data-upload-target="dropzone" data-action="dragover->upload#dragover dragleave->upload#dragleave drop->upload#drop"
             style="display:block; border:1.5px dashed var(--border); border-radius:12px; padding:28px; text-align:center; cursor:pointer; background:var(--canvas); transition:border-color .15s, background .15s;">
        <div style="font-size:28px; margin-bottom:6px;">📸</div>
        <div style="font:600 14px 'Sora',sans-serif;">Click to choose photos, drop them here, or add a .zip</div>
        <%# The HEIC line tracks what this deployment can actually decode, so it
            never promises support the image can't deliver. %>
        <% heic = Photos::ImageSupport.heic_available? %>
        <div class="text-mono-sm" style="margin-top:4px;">
          JPG, PNG<%= ", HEIC" if heic %>, WebP, GIF or a ZIP archive — as many as you like
        </div>
        <div class="text-mono-sm" style="margin-top:4px; color:var(--muted-2);">
          <% if heic %>
            iPhone HEIC photos are converted automatically — upload them as they are
          <% else %>
            iPhone HEIC isn’t supported yet — set Settings → Camera → Formats → Most Compatible
          <% end %>
        </div>
        <%= file_field_tag "photo[images][]", multiple: true,
              accept: "image/*,.heic,.heif,.zip,application/zip", id: "photo_images",
              data: { upload_target: "input", action: "upload#preview" }, style: "display:none;" %>
      </label>
    </div>

    <fieldset style="border:1px solid var(--border); border-radius:12px; padding:14px 16px; margin-bottom:16px;">
      <legend class="text-mono-sm" style="padding:0 6px;">Location (optional)</legend>
      <p class="text-mono-sm" style="margin:0 0 10px; color:var(--muted);">Pick any of these — choosing one narrows the rest. Stored with each photo to help tag products later.</p>
      <div class="form-grid-2">
        <div class="field" style="margin:0;">
          <label class="label" for="photo_community_id">Community</label>
          <%= select_tag "photo[community_id]", options_from_collection_for_select(@communities, :id, :name),
                include_blank: "Any community", id: "photo_community_id",
                data: { catalog_select_target: "community", action: "catalog-select#communityChanged" } %>
        </div>
        <div class="field" style="margin:0;">
          <label class="label" for="photo_floorplan_id">Plan</label>
          <%= select_tag "photo[floorplan_id]", "".html_safe, include_blank: "Any plan", id: "photo_floorplan_id",
                data: { catalog_select_target: "plan", action: "catalog-select#planChanged" } %>
        </div>
        <div class="field" style="margin:0; grid-column:1 / -1;">
          <label class="label" for="photo_room_type_id">Room</label>
          <%# Global vocabulary — available even before a community is synced. %>
          <%= select_tag "photo[room_type_id]",
                options_from_collection_for_select(@room_types, :id, :name),
                include_blank: "Any room", id: "photo_room_type_id" %>
        </div>
        <% if @rooms.any? %>
          <div class="field" style="margin:0; grid-column:1 / -1;">
            <label class="label" for="photo_room_id">Specific room (optional)</label>
            <%= select_tag "photo[room_id]", "".html_safe, id: "photo_room_id", disabled: true,
                  data: { catalog_select_target: "room", action: "catalog-select#roomChanged" } %>
          </div>
        <% end %>
      </div>

      <%# Default on: re-uploading from a phone album that's already organised
          by community and plan is how designers add placement to photos that
          are already here. Tags and pins are never touched. %>
      <label class="text-mono-sm" style="display:flex; gap:8px; align-items:flex-start; margin-top:14px; cursor:pointer;">
        <%= hidden_field_tag "photo[update_existing]", "0" %>
        <%= check_box_tag "photo[update_existing]", "1", true %>
        <span>
          Update photos I’ve already uploaded<br>
          <span style="color:var(--muted);">
            If a photo is already in the library, apply this location to it instead of adding a second copy.
            Existing tags and pins are kept.
          </span>
        </span>
      </label>
    </fieldset>

    <div data-upload-target="preview" class="photo-grid" style="margin-bottom:16px;"></div>

    <div style="display:flex; gap:10px; align-items:center;">
      <%= f.submit "Upload photos", class: "btn btn--primary", data: { upload_target: "submit" } %>
      <%= link_to "Cancel", photos_path, class: "btn btn--ghost" %>
      <span class="text-mono-sm" data-upload-target="count"></span>
    </div>
  <% end %>
</div>
