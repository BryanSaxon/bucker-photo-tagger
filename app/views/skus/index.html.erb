<% content_for :title, "SKU Library" %>

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:16px; margin-bottom:22px; flex-wrap:wrap;">
  <div>
    <span class="eyebrow">Product catalog</span>
    <h1 class="page-title" style="margin-top:6px;">SKU Library</h1>
    <p class="muted" style="margin-top:6px; font-size:14px;"><%= number_with_delimiter(@total) %> SKUs synced from the NewStart catalog.</p>
  </div>

  <%= render "skus/sync_status", latest_sync: @latest_sync %>
</div>

<div class="card card-pad">
  <%= form_with url: skus_path, method: :get, style: "display:flex; gap:10px; align-items:center; margin:6px 0 16px; flex-wrap:wrap;" do |f| %>
    <%= f.search_field :q, value: @query, placeholder: "Search name, code, category…", class: "input", style: "flex:1; min-width:220px;" %>
    <%= f.select :category, options_for_select([["All categories", ""]] + @category_codes.map { |c| [c, c] }, @category),
          {}, { class: "select", style: "width:200px;" } %>
    <%= f.submit "Filter", class: "btn btn--secondary" %>
    <% if @query.present? || @category.present? %>
      <%= link_to "Clear", skus_path, class: "btn btn--ghost btn--sm" %>
    <% end %>
  <% end %>

  <% if @skus.any? %>
    <div style="overflow-x:auto;">
      <table class="data-table">
        <thead>
          <tr>
            <th>Code</th>
            <th>Description</th>
            <th>Category</th>
            <th>Subcategory</th>
            <th>Variants</th>
          </tr>
        </thead>
        <tbody>
          <% @skus.each do |sku| %>
            <tr>
              <td class="mono" style="color:var(--gold-dark); font-weight:600;"><%= sku.product_code %></td>
              <td><%= sku.short_description %></td>
              <td class="text-mono-sm"><%= sku.category_code %></td>
              <td class="text-mono-sm"><%= sku.subcategory_code %></td>
              <td class="text-mono-sm"><%= sku.attribute1_desc.presence || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @total > @skus.size %>
      <p class="text-mono-sm" style="margin-top:14px;">Showing the first <%= @skus.size %> of <%= number_with_delimiter(@total) %> — refine your search to narrow results.</p>
    <% end %>
  <% else %>
    <div class="empty-state">
      <div class="empty-state__icon">📦</div>
      <% if @query.present? || @category.present? %>
        <p>No SKUs match your filters.</p>
      <% else %>
        <p style="margin-bottom:4px;">No SKUs synced yet.</p>
        <p class="text-mono-sm">Trigger a sync to pull the catalog from the NewStart API.</p>
      <% end %>
    </div>
  <% end %>
</div>
