<% content_for :title, "SKU Library" %>

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:16px; margin-bottom:22px; flex-wrap:wrap;">
  <div>
    <span class="eyebrow">Product catalog</span>
    <h1 class="page-title" style="margin-top:6px;">SKU Library</h1>
    <p class="muted" style="margin-top:6px; font-size:14px;">
      <%= number_with_delimiter(@taggable_total) %> taggable products, grouped from
      <%= number_with_delimiter(@total) %> catalog line items.
    </p>
  </div>

  <%= render "skus/sync_status", latest_sync: @latest_sync %>
</div>

<div class="card card-pad">
  <%= form_with url: skus_path, method: :get, style: "display:flex; gap:10px; align-items:center; margin:6px 0 16px; flex-wrap:nowrap;" do |f| %>
    <%= f.search_field :q, value: @query, placeholder: "Search name, code, colour or finish…", class: "input", style: "flex:1 1 auto; min-width:0;" %>
    <%= f.hidden_field :all, value: ("1" if @show_all) %>
    <%= f.submit "Search", class: "btn btn--secondary" %>
    <% if @query.present? %>
      <%= link_to "Clear", skus_path(all: ("1" if @show_all)), class: "btn btn--ghost btn--sm" %>
    <% end %>
  <% end %>

  <%# The catalog carries allowances, contract lines and unsellable entries that
      can never appear in a photograph. Hidden by default, reachable here. %>
  <p class="text-mono-sm" style="margin:-6px 0 16px; color:var(--muted);">
    <% if @show_all %>
      Showing every catalog line item.
      <%= link_to "Show taggable products only", skus_path(q: @query.presence), style: "color:var(--gold-dark);" %>
    <% else %>
      Showing products that have been sold and can appear in a photo.
      <%= link_to "Show everything", skus_path(q: @query.presence, all: "1"), style: "color:var(--gold-dark);" %>
    <% end %>
  </p>

  <% if @skus.any? %>
    <div style="overflow-x:auto;">
      <table class="data-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Category</th>
            <th>Options</th>
            <th style="width:1%;"></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @skus.each do |sku| %>
            <% siblings = @group_sizes[sku.group_key].to_i %>
            <% choices = sku.grouped_attribute_choices %>
            <tr onclick="window.location='<%= sku_path(sku) %>'" style="cursor:pointer;">
              <td>
                <%= link_to sku.display_name, sku_path(sku), style: "font-weight:600; text-decoration:none; color:var(--text);" %>
                <div class="text-mono-sm" style="color:var(--muted-2); margin-top:2px;"><%= sku.product_code %></div>
              </td>
              <td>
                <%= sku.category_label %>
                <%# The subcategory is what separates otherwise-identical rows:
                    "Cabinets" vs "Cabinets - Island". %>
                <div class="text-mono-sm" style="color:var(--muted-2); margin-top:2px;"><%= sku.subcategory_label %></div>
              </td>
              <td class="text-mono-sm">
                <% if choices.any? %>
                  <%= sku.variant_label || "Options" %> · <%= choices.size %>
                <% else %>
                  <span style="color:var(--muted-2);">None</span>
                <% end %>
              </td>
              <td class="text-mono-sm" style="white-space:nowrap; color:var(--muted-2);">
                <%= "#{siblings}×" if siblings > 1 %>
              </td>
              <td class="text-mono-sm" style="text-align:right; color:var(--muted-2);">→</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/pagination", pagy: @pagy %>
  <% else %>
    <div class="empty-state">
      <div class="empty-state__icon">📦</div>
      <% if @query.present? %>
        <p>No SKUs match your search.</p>
      <% else %>
        <p style="margin-bottom:4px;">No SKUs synced yet.</p>
        <p class="text-mono-sm">Trigger a sync to pull the catalog from the NewStart API.</p>
      <% end %>
    </div>
  <% end %>
</div>
