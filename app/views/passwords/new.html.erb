<% content_for :title, "Forgot password" %>

<div class="auth-wrap">
  <div class="auth-card">
    <div style="text-align:center; margin-bottom:22px;">
      <%= image_tag "sig-homes.svg", alt: "SIG Homes", style: "height:40px; width:auto; margin:0 auto 16px; display:block;" %>
      <h1 class="page-title">Reset your password</h1>
      <p class="eyebrow" style="margin-top:8px;">We’ll email you a reset link</p>
    </div>

    <div class="panel card-pad">
      <% if alert = flash[:alert] %>
        <div class="flash flash--alert" id="alert"><span><%= alert %></span></div>
      <% end %>
      <% if notice = flash[:notice] %>
        <div class="flash flash--notice" id="notice"><span><%= notice %></span></div>
      <% end %>

      <%= form_with url: passwords_path do |form| %>
        <div class="field">
          <%= form.label :email_address, "Email", class: "label" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                placeholder: "you@example.com", value: params[:email_address], class: "input" %>
        </div>
        <%= form.submit "Email reset instructions", class: "btn btn--primary", style: "width:100%; margin-top:4px;" %>
      <% end %>

      <div style="text-align:center; margin-top:16px;">
        <%= link_to "← Back to sign in", new_session_path, class: "text-mono-sm", style: "text-decoration:none;" %>
      </div>
    </div>
  </div>
</div>
