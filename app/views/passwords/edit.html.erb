<% content_for :title, @user.pending_invite? ? "Set your password" : "Update your password" %>

<div class="auth-wrap">
  <div class="auth-card">
    <div style="text-align:center; margin-bottom:22px;">
      <%= image_tag "sig-homes.svg", alt: "SIG Homes", style: "height:40px; width:auto; margin:0 auto 16px; display:block;" %>
      <% if @user.pending_invite? %>
        <h1 class="page-title">Welcome to Photo Tagger</h1>
        <p class="eyebrow" style="margin-top:8px;">Set a password to activate your account</p>
      <% else %>
        <h1 class="page-title">Choose a new password</h1>
        <p class="eyebrow" style="margin-top:8px;">for <%= @user.email_address %></p>
      <% end %>
    </div>

    <div class="panel card-pad">
      <% if alert = flash[:alert] %>
        <div class="flash flash--alert" id="alert"><span><%= alert %></span></div>
      <% end %>

      <%= form_with url: password_path(params[:token]), method: :put do |form| %>
        <div class="field">
          <%= form.label :password, "New password", class: "label" %>
          <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password",
                placeholder: "At least 8 characters", minlength: 8, maxlength: 72, class: "input" %>
        </div>
        <div class="field">
          <%= form.label :password_confirmation, "Confirm password", class: "label" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
                placeholder: "Repeat new password", maxlength: 72, class: "input" %>
        </div>
        <%= form.submit(@user.pending_invite? ? "Set password" : "Save password",
              class: "btn btn--primary", style: "width:100%; margin-top:4px;") %>
      <% end %>
    </div>
  </div>
</div>
