<% content_for :title, "Room types" %>

<div style="margin-bottom:22px;">
  <span class="eyebrow">Tagging</span>
  <h1 class="page-title" style="margin-top:6px;">Room types</h1>
  <p class="muted" style="margin-top:6px; font-size:14px;">
    The room list designers pick from when tagging a photo. Drag a row to change the order they appear
    in, and rename them to match how your team talks about rooms — changes apply immediately. Hiding a
    room type keeps it off the tagging screen without affecting photos already tagged with it.
  </p>
</div>

<div class="panel card-pad" style="margin-bottom:22px;">
  <span class="eyebrow">Add a room type</span>
  <%# Attributes go through html:, not the top level — form_with drops a
      top-level style: when it is given a model. %>
  <%= form_with model: @room_type, url: room_types_path, method: :post,
        html: { style: "display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap; margin-top:12px;" } do |f| %>
    <div class="field" style="flex:1 1 260px; margin:0;">
      <%= f.label :name, "Name", class: "label" %>
      <%= f.text_field :name, class: "input", placeholder: "e.g. Screened Porch", required: true %>
    </div>
    <%= f.submit "Add room type", class: "btn btn--primary" %>
    <span class="text-mono-sm" style="color:var(--muted-2); padding-bottom:12px;">
      Added to the end of the list — drag it where you want it.
    </span>
  <% end %>
</div>

<div class="card card-pad" data-controller="sortable" data-sortable-url-value="<%= reorder_room_types_path %>">
  <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:12px;">
    <span class="eyebrow"><%= pluralize(@room_types.size, "room type") %></span>
    <span class="text-mono-sm" data-sortable-status style="color:var(--muted);"></span>
  </div>

  <div style="overflow-x:auto;">
    <table class="data-table">
      <thead>
        <tr>
          <th style="width:1%;"><span class="sr-only">Reorder</span></th>
          <th>Name</th>
          <th style="width:120px;">Status</th>
          <th style="width:1%;"></th>
        </tr>
      </thead>
      <tbody data-sortable-target="list"
             data-action="dragover->sortable#over drop->sortable#drop">
        <% @room_types.each do |room_type| %>
          <% form_id = dom_id(room_type, :form) %>
          <tr data-sortable-id="<%= room_type.id %>" draggable="true"
              data-action="dragstart->sortable#start dragend->sortable#end">
            <td class="sortable-handle" aria-hidden="true" title="Drag to reorder">⠿</td>
            <td>
              <%= form_with model: room_type, url: room_type_path(room_type), method: :patch,
                    id: form_id do |f| %>
                <%# draggable="false" so selecting text in the field doesn't
                    start a row drag. %>
                <%= f.text_field :name, class: "input input--sm", draggable: "false",
                      "aria-label": "Room type name" %>
              <% end %>
            </td>
            <td>
              <% if room_type.active? %>
                <span class="badge badge--done"><span class="badge__dot"></span>Shown</span>
              <% else %>
                <span class="badge badge--neutral"><span class="badge__dot"></span>Hidden</span>
              <% end %>
            </td>
            <td style="text-align:right; white-space:nowrap;">
              <%= submit_tag "Save", form: form_id, class: "btn btn--secondary btn--sm" %>
              <%= button_to (room_type.active? ? "Hide" : "Show"),
                    room_type_path(room_type), method: :patch,
                    params: { "room_type[active]" => (room_type.active? ? "0" : "1") },
                    class: "btn btn--ghost btn--sm", form: { style: "display:inline;" } %>
              <%# Removing a type that's in use would strip the room from photos
                  already tagged with it, so the controller hides it instead. %>
              <%= button_to "Remove", room_type_path(room_type), method: :delete,
                    class: "btn btn--ghost btn--sm",
                    form: { style: "display:inline;",
                            data: { turbo_confirm: "Remove “#{room_type.name}”? If it’s already in use it will be hidden instead." } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
